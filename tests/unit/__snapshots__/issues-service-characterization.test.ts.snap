exports[`issues service 搬移前特征 > reassign 状态、日志、预警与工序恢复的固定副作用顺序 1`] = `
{
  "calls": [
    [
      "transaction.begin",
    ],
    [
      "issue.findUnique",
      {
        "where": {
          "id": "issue",
        },
      },
    ],
    [
      "notifyRole.findMany",
      {
        "where": {
          "userId": "owner",
        },
      },
    ],
    [
      "workOrderExt.findMany",
      {
        "select": {
          "projectManagerId": true,
          "workOrderNumber": true,
        },
        "where": {
          "workOrderNumber": {
            "in": [
              "WO",
            ],
          },
        },
      },
    ],
    [
      "qmsDepartment.findMany",
      {
        "select": {
          "id": true,
          "isDeleted": true,
          "name": true,
        },
        "where": {
          "id": {
            "in": [
              "dept",
              "new-dept",
            ],
          },
        },
      },
    ],
    [
      "qmsUser.findFirst",
      {
        "select": {
          "id": true,
        },
        "where": {
          "id": "new-owner",
          "isDeleted": false,
        },
      },
    ],
    [
      "issue.updateMany",
      {
        "data": {
          "dueDate": 2026-11-04T00:00:00.000Z,
          "responsibleDeptId": "new-dept",
          "responsibleSupplierId": null,
          "responsibleUserId": "new-owner",
          "status": "OPEN",
        },
        "where": {
          "id": "issue",
          "status": "OPEN",
        },
      },
    ],
    [
      "issueLog.create",
      {
        "data": {
          "actorId": "owner",
          "fromStatus": null,
          "issueId": "issue",
          "note": "改派：责任部门 技术部 → 生产部，责任人 负责人 → new-owner，外协单位 供应商 → 无，要求解决日 无 → 2026-11-04；说明",
          "toStatus": null,
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
          "status": "CLEARED",
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "ACTIVE",
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "CONVERTED",
        },
      },
    ],
    [
      "transaction.commit",
    ],
  ],
  "result": {
    "ok": true,
  },
}
`;

