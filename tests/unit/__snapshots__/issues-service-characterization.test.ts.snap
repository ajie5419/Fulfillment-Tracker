exports[`issues service 搬移前特征 > accept 状态、日志、预警与工序恢复的固定副作用顺序 1`] = `
{
  "calls": [
    [
      "transaction.begin",
    ],
    [
      "issue.findUnique",
      {
        "where": {
          "id": "issue",
        },
      },
    ],
    [
      "notifyRole.findMany",
      {
        "where": {
          "userId": "owner",
        },
      },
    ],
    [
      "workOrderExt.findMany",
      {
        "select": {
          "projectManagerId": true,
          "workOrderNumber": true,
        },
        "where": {
          "workOrderNumber": {
            "in": [
              "WO",
            ],
          },
        },
      },
    ],
    [
      "qmsDepartment.findMany",
      {
        "select": {
          "id": true,
          "isDeleted": true,
          "name": true,
        },
        "where": {
          "id": {
            "in": [
              "dept",
            ],
          },
        },
      },
    ],
    [
      "issue.updateMany",
      {
        "data": {
          "dueDate": 2026-11-04T00:00:00.000Z,
          "responsibleUserId": "owner",
          "status": "ACCEPTED",
        },
        "where": {
          "id": "issue",
          "status": "OPEN",
        },
      },
    ],
    [
      "issueLog.create",
      {
        "data": {
          "actorId": "owner",
          "fromStatus": "OPEN",
          "issueId": "issue",
          "note": "受理；要求解决日 2026-11-04（默认受理后 3 天）；已受理",
          "toStatus": "ACCEPTED",
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
          "status": "CLEARED",
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "ACTIVE",
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "CONVERTED",
        },
      },
    ],
    [
      "transaction.commit",
    ],
  ],
  "result": {
    "ok": true,
  },
}
`;

exports[`issues service 搬移前特征 > close 状态、日志、预警与工序恢复的固定副作用顺序 1`] = `
{
  "calls": [
    [
      "issue.findUnique",
      {
        "select": {
          "refId": true,
          "refType": true,
        },
        "where": {
          "id": "issue",
        },
      },
    ],
    [
      "transaction.begin",
    ],
    [
      "lockStep",
      "step",
    ],
    [
      "issue.findUnique",
      {
        "where": {
          "id": "issue",
        },
      },
    ],
    [
      "notifyRole.findMany",
      {
        "where": {
          "userId": "owner",
        },
      },
    ],
    [
      "workOrderExt.findMany",
      {
        "select": {
          "projectManagerId": true,
          "workOrderNumber": true,
        },
        "where": {
          "workOrderNumber": {
            "in": [
              "WO",
            ],
          },
        },
      },
    ],
    [
      "issue.updateMany",
      {
        "data": {
          "status": "CLOSED",
        },
        "where": {
          "id": "issue",
          "status": "RESOLVED",
        },
      },
    ],
    [
      "issueLog.create",
      {
        "data": {
          "actorId": "owner",
          "fromStatus": "RESOLVED",
          "issueId": "issue",
          "note": "确认关闭；确认",
          "toStatus": "CLOSED",
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
          "status": "CLEARED",
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "ACTIVE",
        },
      },
    ],
    [
      "alert.updateMany",
      {
        "data": {
          "activeKey": null,
        },
        "where": {
          "activeKey": {
            "in": [
              "W4:issue:issue",
            ],
          },
          "status": "CONVERTED",
        },
      },
    ],
    [
      "issue.count",
      {
        "where": {
          "id": {
            "not": "issue",
          },
          "refId": "step",
          "refType": "STEP",
          "status": {
            "not": "CLOSED",
          },
        },
      },
    ],
    [
      "restoreBlockedStep",
      "step",
    ],
    [
      "transaction.commit",
    ],
  ],
  "result": {
    "ok": true,
    "stepRestored": "step",
  },
}
`;

