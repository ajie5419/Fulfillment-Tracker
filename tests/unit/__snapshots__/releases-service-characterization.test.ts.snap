exports[`releases service 搬移前特征 > list 固定查询与完整 DTO 1`] = `
{
  "calls": [
    [
      "release.findMany",
      {
        "include": {
          "receipts": {
            "select": {
              "status": true,
              "userId": true,
            },
          },
        },
        "orderBy": [
          {
            "createdAt": "desc",
          },
          {
            "id": "desc",
          },
        ],
        "where": {
          "AND": [
            {
              "workOrderNumber": "WO",
            },
            {
              "type": "CHANGE",
            },
            {
              "receipts": {
                "some": {
                  "userId": "owner",
                },
              },
            },
            {
              "OR": [
                {
                  "workOrderNumber": {
                    "in": [
                      "WO",
                    ],
                  },
                },
                {
                  "issuerId": "owner",
                },
                {
                  "receipts": {
                    "some": {
                      "userId": "owner",
                    },
                  },
                },
              ],
            },
            {
              "receipts": {
                "some": {
                  "status": "PENDING",
                  "userId": "owner",
                },
              },
              "status": "ACTIVE",
            },
          ],
        },
      },
    ],
    [
      "part.findMany",
      {
        "select": {
          "drawingNo": true,
          "id": true,
          "name": true,
        },
        "where": {
          "id": {
            "in": [
              "part",
              "missing",
            ],
          },
        },
      },
    ],
    [
      "routeStep.groupBy",
      {
        "_count": {
          "_all": true,
        },
        "by": [
          "holdReleaseId",
        ],
        "where": {
