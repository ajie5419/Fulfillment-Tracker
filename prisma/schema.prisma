// 履约系统数据表（第一期）。依据：技术选型与MVP范围.md 第 4 节、系统方案设计.md 第 4.2/4.3 节。
// qms_ 开头的表是 QMS 只读副本，只允许同步任务（R2 sync-qms，server/services/sync）写入；
// 字段按 QMS 只读增量同步接口（GET /api/integration/fulfillment/<resource>）契约 v1。
// 演示数据（DEMO- 前缀）也写在这些表里，可与真实同步来的行共存，清除演示数据只删 DEMO- 行。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── QMS 只读副本 ─────────────

model QmsWorkOrder {
  workOrderNumber String   @id @db.VarChar(64)
  customerName    String
  projectName     String?
  division        String?
  quantity        Int
  deliveryDate    DateTime
  status          String   @db.VarChar(20) // OPEN / IN_PROGRESS / COMPLETED / CANCELLED
  isDeleted       Boolean  @default(false)
  updatedAt       DateTime // QMS 的 updatedAt，不是本地写入时间
  syncedAt        DateTime @default(now()) @updatedAt

  @@index([status])
  @@map("qms_work_order")
}

/// 外协单位：QMS 供应商（kind = SUPPLIER）和厂内外协班组（kind = TEAM，id 即报检上的 teamId）
model QmsSupplier {
  id              String   @id @db.VarChar(64)
  name            String
  outsourcingMode String?
  category        String?
  kind            String   @default("SUPPLIER") @db.VarChar(20) // SUPPLIER / TEAM
  status          String?  @db.VarChar(40) // QMS suppliers.status，如 Qualified
  isDeleted       Boolean  @default(false)
  updatedAt       DateTime
  syncedAt        DateTime @default(now()) @updatedAt

  @@map("qms_supplier")
}

model QmsProcess {
  id                      String   @id @db.VarChar(64)
  name                    String
  code                    String?  @db.VarChar(64)
  status                  Int      @default(1) // 1 = 启用
  supplierSource          String   @default("Supplier") @db.VarChar(20) // QMS processes.supplierSource（同步接口不输出，保留默认值）
  responsibleDepartmentId String?  @db.VarChar(64)
  isDeleted               Boolean  @default(false)
  updatedAt               DateTime
  syncedAt                DateTime @default(now()) @updatedAt

  @@map("qms_process")
}

model QmsDepartment {
  id        String   @id @db.VarChar(64)
  name      String
  parentId  String   @db.VarChar(64)
  status    Int
  isDeleted Boolean  @default(false)
  updatedAt DateTime
  syncedAt  DateTime @default(now()) @updatedAt

  @@map("qms_department")
}

/// QMS 用户（不同步手机号、邮箱、企业微信 ID、密码相关字段）
model QmsUser {
  id           String   @id @db.VarChar(64)
  username     String
  realName     String?
  /// QMS users.department 存的是部门 ID（departments.id），不是名称；要名称经 qms_department 查
  departmentId String?  @db.VarChar(64)
  roleId       String?  @db.VarChar(64) // 同步接口不输出；演示数据填
  roleName     String?
  status       String   @db.VarChar(20) // ACTIVE / INACTIVE（同步时由 isActive 换算）
  isDeleted    Boolean  @default(false)
  updatedAt    DateTime
  syncedAt     DateTime @default(now()) @updatedAt

  @@index([departmentId])
  @@map("qms_user")
}

model QmsInspection {
  id                  String    @id @db.VarChar(64)
  requestNo           String    @db.VarChar(64)
  workOrderNumber     String    @db.VarChar(64) // 主工单
  /// 主工单 + 关联工单（qms_inspection_request_work_orders）去重后的全部工单号，JSON 字符串数组；匹配时任一工单命中即为候选
  workOrderNumbers    Json?
  partId              String?   @db.VarChar(64)
  partName            String
  processId           String?   @db.VarChar(64)
  processName         String
  supplierId          String?   @db.VarChar(64)
  supplierName        String?
  /// 厂内外协班组（qms_supplier 里 kind = TEAM 的同一 id）；没有 supplierId 时按它匹配外协单位
  teamId              String?   @db.VarChar(64)
  teamName            String?
  category            String?   @db.VarChar(40)
  responsibilityType  String?
  quantity            Int
  // 注意 QMS 的实际行为：inspectionResult 默认 PASS（PASS 不代表已检合格）；
  // 判不合格时写 inspectionResult=FAIL、unqualifiedQuantity，status 仍是 INSPECTING、closedAt 为空；
  // 复检合格后会被覆盖成 CLOSED+PASS，"曾经不合格"靠 linkedIssueId/linkedIssueNo 非空识别。
  // 不合格判定（转异常）：inspectionResult=FAIL 或 linkedIssueId/No 非空，且 status≠CANCELLED（见 services/issues/nonconforming.ts）
  status              String    @db.VarChar(20) // SUBMITTED / DISPATCHED / INSPECTING / CLOSED / CANCELLED
  inspectionResult    String    @db.VarChar(20) // PASS / FAIL / CONDITIONAL / NA
  unqualifiedQuantity Int?
  linkedIssueId       String?   @db.VarChar(64) // QMS 质量问题单
  linkedIssueNo       String?
  reporterId          String?   @db.VarChar(64)
  submittedAt         DateTime
  closedAt            DateTime?
  isDeleted           Boolean   @default(false)
  updatedAt           DateTime
  syncedAt            DateTime  @default(now()) @updatedAt

  @@index([workOrderNumber])
  @@index([supplierId])
  @@index([teamId])
  @@map("qms_inspection")
}

/// 每类资源一行；游标为 (since, afterId) 复合游标，即已写入的最后一行的 (updatedAt, key)。
/// 每页写入成功后与该页数据在同一事务里推进；失败只记 lastError、failCount + 1，游标不动。
model SyncCursor {
  resource     String    @id @db.VarChar(40)
  since        DateTime?
  afterId      String?   @db.VarChar(64)
  /// 最近一次尝试同步的时间（成功或失败）
  lastRunAt    DateTime?
  /// 最近一次成功追平（拉到 nextCursor = null）的时间；看板取各资源的最小值
  lastSyncedAt DateTime?
  lastError    String?   @db.Text
  /// 连续失败次数，成功后归零
  failCount    Int       @default(0)
  /// 本轮故障已给管理员发过提醒的时间（连续失败 3 次时发一次），恢复成功后清空
  alertedAt    DateTime?

  @@map("sync_cursor")
}

// ───────────── 履约业务表 ─────────────

model WorkOrderExt {
  workOrderNumber  String  @id @db.VarChar(64)
  projectManagerId String? @db.VarChar(64) // QMS 用户 ID
  productLine      String?
  isPilot          Boolean @default(false)

  @@map("work_order_ext")
}

enum PartStatus {
  ACTIVE
  DONE
}

model Part {
  id              String     @id @default(cuid())
  workOrderNumber String     @db.VarChar(64)
  name            String
  drawingNo       String?
  quantity        Int        @default(1)
  qmsPartId       String?    @db.VarChar(64) // 引用 QMS BOM 物料 ID，用于报检匹配
  /// 从 QMS 项目 BOM 导入时的 BOM 行 ID（project_boms.id）；同一工单下唯一，重复导入据此跳过。手工建的工件为空
  qmsBomId        String?    @db.VarChar(191)
  currentStepId   String?
  status          PartStatus @default(ACTIVE)
  statusSince     DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  steps           RouteStep[]

  @@unique([workOrderNumber, qmsBomId])
  @@index([workOrderNumber])
  @@index([qmsPartId])
  @@map("part")
}

enum StepMode {
  SELF // 自制
  IN_PLANT_OUTSOURCE // 厂内外协
  EXTERNAL_OUTSOURCE // 厂外外协
}

// 方案 4.3 状态机：待开工 → 在外加工/加工中 → 已完成 ⇄ 有异常
enum StepStatus {
  PENDING // 待开工
  OUT // 在外加工（厂外外协已发出）
  IN_PROGRESS // 加工中（自制/厂内外协）
  DONE // 已完成
  BLOCKED // 有异常（检验不合格）
}

model RouteStep {
  id                 String     @id @default(cuid())
  partId             String
  seq                Int
  processId          String     @db.VarChar(64) // QMS processes.id
  mode               StepMode
  supplierId         String?    @db.VarChar(64) // QMS suppliers.id（外协时）
  ownerId            String?    @db.VarChar(64) // 负责人，QMS 用户 ID
  dueDate            DateTime?
  promisedReturnDate DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  status             StepStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  part               Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  events             FlowEvent[]

  @@unique([partId, seq])
  @@index([status])
  @@index([supplierId])
  @@map("route_step")
}

/// 工序路线模板（R8）：常用工序链。套用时把步骤复制到工件上，之后改模板不影响已套用的工件（复制即版本）
model RouteTemplate {
  id          String              @id @default(cuid())
  name        String              @unique @db.VarChar(191)
  description String?             @db.Text
  createdBy   String?             @db.VarChar(64)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  steps       RouteTemplateStep[]

  @@map("route_template")
}

model RouteTemplateStep {
  id          String        @id @default(cuid())
  templateId  String
  seq         Int
  processId   String        @db.VarChar(64) // QMS processes.id
  mode        StepMode
  supplierId  String?       @db.VarChar(64) // 外协时的默认外协厂，可空
  /// 默认工期（天）。套用时给了开工日才据此推算各道的要求完成日
  defaultDays Int?
  template    RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, seq])
  @@map("route_template_step")
}

enum FlowEventType {
  SEND // 发出
  RETURN // 返厂（QMS 报检）
  RETURN_MANUAL // 补登返厂（漏报兜底）
  START // 开工
  FINISH // 完工
}

enum FlowSource {
  MOBILE
  QMS_INSPECTION
  PC
}

/// 只允许新增，不允许修改（T9）。服务层不提供 update/delete。
model FlowEvent {
  id              String        @id @default(cuid())
  stepId          String
  type            FlowEventType
  qty             Int
  source          FlowSource
  qmsInspectionId String?       @unique @db.VarChar(64) // 同一报检重复同步时据此幂等跳过（T6）
  actorId         String?       @db.VarChar(64)
  occurredAt      DateTime
  createdAt       DateTime      @default(now())
  step            RouteStep     @relation(fields: [stepId], references: [id])

  @@index([stepId])
  @@map("flow_event")
}

enum TodoStatus {
  OPEN
  DONE
  TRANSFERRED
  CANCELLED
}

model Todo {
  id        String     @id @default(cuid())
  ownerId   String     @db.VarChar(64)
  action    String     @db.VarChar(40) // 如 ARRANGE_SEND / ARRANGE_START / HANDLE_ISSUE / CONFIRM_MATCH
  refType   String     @db.VarChar(20)
  refId     String     @db.VarChar(64)
  dueAt     DateTime?
  status    TodoStatus @default(OPEN)
  doneAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([ownerId, status])
  @@index([refType, refId])
  @@map("todo")
}

enum UnmatchedStatus {
  PENDING
  RESOLVED
  IGNORED
}

model UnmatchedInspection {
  qmsInspectionId String          @id @db.VarChar(64)
  reason          String          @db.VarChar(40) // NO_CANDIDATE / MULTIPLE / CANCELLED_AFTER_MATCH
  candidates      Json?
  status          UnmatchedStatus @default(PENDING)
  resolvedBy      String?         @db.VarChar(64)
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([status])
  @@map("unmatched_inspection")
}

enum IssueCategory {
  DESIGN // 设计
  CHANGE // 变更
  MATERIAL_PAYMENT // 物料-付款原因
  MATERIAL_MGMT // 物料-管理原因
  OUTSOURCE_SCHEDULE // 外协-进度
  OUTSOURCE_QUALITY // 外协-质量
  WORKSHOP // 车间
  CUSTOMER // 客户
  OTHER // 其他
}

enum IssueSource {
  MANUAL
  ALERT
  QMS_NONCONFORMING
}

enum IssueStatus {
  OPEN // 待受理
  ACCEPTED // 处理中
  RESOLVED // 已处理，待确认
  CLOSED // 已关闭
}

model Issue {
  id                 String        @id @default(cuid())
  issueNo            String        @unique @db.VarChar(32)
  workOrderNumber    String        @db.VarChar(64)
  refType            String?       @db.VarChar(20)
  refId              String?       @db.VarChar(64)
  category           IssueCategory
  description        String        @db.Text
  photos             Json?
  reporterId         String?       @db.VarChar(64)
  source             IssueSource
  responsibleDeptId  String?       @db.VarChar(64)
  responsibleUserId  String?       @db.VarChar(64)
  responsibleSupplierId String?    @db.VarChar(64)
  dueDate            DateTime?
  status             IssueStatus   @default(OPEN)
  escalationLevel    Int           @default(0)
  /// 系统来源的幂等键："QMS:<报检 ID>"、"ALERT:<预警 ID>"；手工上报为空（MySQL 唯一索引允许多个 NULL）
  sourceKey          String?       @unique @db.VarChar(120)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  logs               IssueLog[]

  @@index([workOrderNumber, status])
  @@index([refType, refId])
  @@index([status])
  @@map("issue")
}

model IssueLog {
  id         String       @id @default(cuid())
  issueId    String
  fromStatus IssueStatus?
  toStatus   IssueStatus?
  note       String?      @db.Text
  actorId    String?      @db.VarChar(64)
  createdAt  DateTime     @default(now())
  issue      Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("issue_log")
}

enum AlertRule {
  W1
  W2
  W3
  W4
}

enum AlertLevel {
  REMIND
  YELLOW
  RED
}

enum AlertStatus {
  ACTIVE
  CLEARED
  CONVERTED // 已转异常
}

/// 同一对象同一规则只保留一条活动预警：MySQL 无部分唯一索引，
/// 用 activeKey（活动时 = "rule:refType:refId"，消除后置 null）上的唯一约束实现。
model Alert {
  id             String      @id @default(cuid())
  rule           AlertRule
  refType        String      @db.VarChar(20)
  refId          String      @db.VarChar(64)
  level          AlertLevel
  firstAt        DateTime
  levelAt        DateTime
  lastNotifiedAt DateTime?
  status         AlertStatus @default(ACTIVE)
  activeKey      String?     @unique @db.VarChar(120)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([refType, refId])
  @@map("alert")
}

model Reminder {
  id        String     @id @default(cuid())
  userId    String     @db.VarChar(64)
  alertId   String?
  todoId    String?
  title     String
  level     AlertLevel @default(REMIND)
  /// 提醒种类：空 = 预警/待办类；DIGEST = 每日汇总；SYNC_FAIL = QMS 同步连续失败（发给管理员，未读时置顶）
  kind      String?    @db.VarChar(20)
  /// 每日汇总的正文（前 5 项，一行一项）
  body      String?    @db.Text
  /// 防重复：每日汇总 "DIGEST:<YYYY-MM-DD>:<userId>"，同人同日只有一条；同步失败 "SYNC_FAIL:<故障开始时间>:<userId>"，同一轮故障只有一条
  dedupeKey String?    @unique @db.VarChar(120)
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, readAt])
  // 同一个人在同一条预警的同一个级别上只收一条（alertId 为空的待办类提醒不受限，MySQL 唯一索引允许多个 NULL）
  @@unique([alertId, level, userId])
  @@map("reminder")
}

/// 阈值表。各列含义按规则不同：W1 提醒为小时；W3 的 remindHours 是"承诺返回日前多少小时"（48 = 前 2 天），
/// W3 的黄/红是超期天数。表里没有的规则用 services/alerts/rules.ts 的默认值。
model Threshold {
  rule        AlertRule @id
  remindHours Int?
  yellowDays  Int
  redDays     Int

  @@map("threshold")
}

model OffDay {
  date DateTime @id @db.Date

  @@map("off_day")
}

enum NotifyRoleKind {
  OUTSOURCE_COORDINATOR // 外协专员（W1 的责任人）
  DEPT_HEAD // 部门负责人，department 填部门名称（qms_user.departmentId 经 qms_department 换成名称后对应）
  PROJECT_DEPT_HEAD // 项目部负责人
  LEADER // 分管领导
}

/// 预警升级阶梯的通知对象（方案 6.2）。QMS 里没有这些角色，先在设置页手工维护。
model NotifyRole {
  id         String         @id @default(cuid())
  role       NotifyRoleKind
  userId     String         @db.VarChar(64)
  department String?        @db.VarChar(191)

  @@index([role])
  @@map("notify_role")
}

/// 后台任务防重叠的租约锁：lockedUntil 未过期即被占用；进程崩溃后租约到期自动失效，不依赖数据库连接。
model JobLock {
  name        String   @id @db.VarChar(40)
  lockedUntil DateTime @db.DateTime(3)
  holder      String?  @db.VarChar(64)

  @@map("job_lock")
}

/// 上传的文件（异常照片）。文件存在 runtimeConfig.uploadDir 下，文件名是随机 id，不用用户给的文件名。
/// issueId：上报异常时绑定；未绑定的只有上传人自己能读取，绑定后按异常所属工单的可见范围判断。
model UploadFile {
  id         String   @id @db.VarChar(64)
  storedName String   @db.VarChar(80)
  mime       String   @db.VarChar(40)
  size       Int
  uploaderId String   @db.VarChar(64)
  issueId    String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([issueId])
  @@map("upload_file")
}

// ───────────── 登录会话 ─────────────

/// 履约自己的会话（30 天）。id 存的是 cookie 令牌的 SHA-256，库里不存明文令牌。
model Session {
  id         String   @id @db.Char(64)
  qmsUserId  String   @db.VarChar(64)
  userName   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([qmsUserId])
  @@index([expiresAt])
  @@map("session")
}

/// 登录进行中的临时记录（10 分钟）：state 一次性消费，code_verifier 只存在服务端。
model LoginAttempt {
  id           String   @id @db.Char(64) // state 的 SHA-256
  codeVerifier String   @db.VarChar(128)
  redirect     String   @db.VarChar(512)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("login_attempt")
}
