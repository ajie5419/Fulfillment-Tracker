// 履约系统数据表（第一期）。依据：技术选型与MVP范围.md 第 4 节、系统方案设计.md 第 4.2/4.3 节。
// qms_ 开头的表是 QMS 只读副本，只允许同步任务（R2 sync-qms，server/services/sync）写入；
// 字段按 QMS 只读增量同步接口（GET /api/integration/fulfillment/<resource>）契约 v1。
// 演示数据（DEMO- 前缀）也写在这些表里，可与真实同步来的行共存，清除演示数据只删 DEMO- 行。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── QMS 只读副本 ─────────────

model QmsWorkOrder {
  workOrderNumber String   @id @db.VarChar(64)
  customerName    String
  projectName     String?
  division        String?
  quantity        Int
  deliveryDate    DateTime
  status          String   @db.VarChar(20) // OPEN / IN_PROGRESS / COMPLETED / CANCELLED
  isDeleted       Boolean  @default(false)
  updatedAt       DateTime // QMS 的 updatedAt，不是本地写入时间
  syncedAt        DateTime @default(now()) @updatedAt

  @@index([status])
  @@map("qms_work_order")
}

/// 外协单位：QMS 供应商（kind = SUPPLIER）和厂内外协班组（kind = TEAM，id 即报检上的 teamId）
model QmsSupplier {
  id              String   @id @db.VarChar(64)
  name            String
  outsourcingMode String?
  category        String?
  kind            String   @default("SUPPLIER") @db.VarChar(20) // SUPPLIER / TEAM
  status          String?  @db.VarChar(40) // QMS suppliers.status，如 Qualified
  isDeleted       Boolean  @default(false)
  updatedAt       DateTime
  syncedAt        DateTime @default(now()) @updatedAt
  /// 班组长（只对 kind = TEAM 有意义）：单独一张表，QMS 同步只 upsert 本表的契约字段，碰不到它
  leader          TeamLeader?

  @@map("qms_supplier")
}

model QmsProcess {
  id                      String   @id @db.VarChar(64)
  name                    String
  code                    String?  @db.VarChar(64)
  status                  Int      @default(1) // 1 = 启用
  supplierSource          String   @default("Supplier") @db.VarChar(20) // QMS processes.supplierSource（同步接口不输出，保留默认值）
  responsibleDepartmentId String?  @db.VarChar(64)
  isDeleted               Boolean  @default(false)
  updatedAt               DateTime
  syncedAt                DateTime @default(now()) @updatedAt

  @@map("qms_process")
}

model QmsDepartment {
  id        String   @id @db.VarChar(64)
  name      String
  parentId  String   @db.VarChar(64)
  status    Int
  isDeleted Boolean  @default(false)
  updatedAt DateTime
  syncedAt  DateTime @default(now()) @updatedAt

  @@map("qms_department")
}

/// QMS 用户（不同步手机号、邮箱、企业微信 ID、密码相关字段）
model QmsUser {
  id           String   @id @db.VarChar(64)
  username     String
  realName     String?
  /// QMS users.department 存的是部门 ID（departments.id），不是名称；要名称经 qms_department 查
  departmentId String?  @db.VarChar(64)
  roleId       String?  @db.VarChar(64) // 同步接口不输出；演示数据填
  roleName     String?
  status       String   @db.VarChar(20) // ACTIVE / INACTIVE（同步时由 isActive 换算）
  isDeleted    Boolean  @default(false)
  updatedAt    DateTime
  syncedAt     DateTime @default(now()) @updatedAt
  /// 担任班组长的班组
  ledTeams     TeamLeader[]

  @@index([departmentId])
  @@map("qms_user")
}

model QmsInspection {
  id                  String    @id @db.VarChar(64)
  requestNo           String    @db.VarChar(64)
  workOrderNumber     String    @db.VarChar(64) // 主工单
  /// 主工单 + 关联工单（qms_inspection_request_work_orders）去重后的全部工单号，JSON 字符串数组；匹配时任一工单命中即为候选
  workOrderNumbers    Json?
  partId              String?   @db.VarChar(64)
  partName            String
  processId           String?   @db.VarChar(64)
  processName         String
  supplierId          String?   @db.VarChar(64)
  supplierName        String?
  /// 厂内外协班组（qms_supplier 里 kind = TEAM 的同一 id）；没有 supplierId 时按它匹配外协单位
  teamId              String?   @db.VarChar(64)
  teamName            String?
  category            String?   @db.VarChar(40)
  responsibilityType  String?
  quantity            Int
  // 注意 QMS 的实际行为：inspectionResult 默认 PASS（PASS 不代表已检合格）；
  // 判不合格时写 inspectionResult=FAIL、unqualifiedQuantity，status 仍是 INSPECTING、closedAt 为空；
  // 复检合格后会被覆盖成 CLOSED+PASS，"曾经不合格"靠 linkedIssueId/linkedIssueNo 非空识别。
  // 不合格判定（转异常）：inspectionResult=FAIL 或 linkedIssueId/No 非空，且 status≠CANCELLED（见 services/issues/nonconforming.ts）
  status              String    @db.VarChar(20) // SUBMITTED / DISPATCHED / INSPECTING / CLOSED / CANCELLED
  inspectionResult    String    @db.VarChar(20) // PASS / FAIL / CONDITIONAL / NA
  unqualifiedQuantity Int?
  linkedIssueId       String?   @db.VarChar(64) // QMS 质量问题单
  linkedIssueNo       String?
  reporterId          String?   @db.VarChar(64)
  submittedAt         DateTime
  closedAt            DateTime?
  isDeleted           Boolean   @default(false)
  updatedAt           DateTime
  syncedAt            DateTime  @default(now()) @updatedAt

  @@index([workOrderNumber])
  @@index([supplierId])
  @@index([teamId])
  @@map("qms_inspection")
}

/// 每类资源一行；游标为 (since, afterId) 复合游标，即已写入的最后一行的 (updatedAt, key)。
/// 每页写入成功后与该页数据在同一事务里推进；失败只记 lastError、failCount + 1，游标不动。
model SyncCursor {
  resource     String    @id @db.VarChar(40)
  since        DateTime?
  afterId      String?   @db.VarChar(64)
  /// 最近一次尝试同步的时间（成功或失败）
  lastRunAt    DateTime?
  /// 最近一次成功追平（拉到 nextCursor = null）的时间；看板取各资源的最小值
  lastSyncedAt DateTime?
  lastError    String?   @db.Text
  /// 连续失败次数，成功后归零
  failCount    Int       @default(0)
  /// 本轮故障已给管理员发过提醒的时间（连续失败 3 次时发一次），恢复成功后清空
  alertedAt    DateTime?

  @@map("sync_cursor")
}

// ───────────── 履约业务表 ─────────────

model WorkOrderExt {
  workOrderNumber  String  @id @db.VarChar(64)
  projectManagerId String? @db.VarChar(64) // QMS 用户 ID
  productLine      String?
  isPilot          Boolean @default(false)

  @@map("work_order_ext")
}

enum PartStatus {
  ACTIVE
  DONE
}

model Part {
  id              String             @id @default(cuid())
  workOrderNumber String             @db.VarChar(64)
  name            String
  drawingNo       String?
  /// 版号（技术部 BOM 里的版本），可空
  revision        String?            @db.VarChar(64)
  quantity        Int                @default(1)
  qmsPartId       String?            @db.VarChar(64) // 引用 QMS BOM 物料 ID，用于报检匹配
  /// 从 QMS 项目 BOM 导入时的 BOM 行 ID（project_boms.id）；同一工单下唯一，重复导入据此跳过。手工建的工件为空
  qmsBomId        String?            @db.VarChar(191)
  /// 从技术部 BOM Excel（CAD 导出）导入的工件；QMS BOM 之后按图号关联上来，不再另建
  fromTechBom     Boolean            @default(false)
  currentStepId   String?
  status          PartStatus         @default(ACTIVE)
  statusSince     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  steps           RouteStep[]
  /// 挂在这个工件上的关键物料（R10）；全部到货时给第一道工序负责人发"可以开工"待办
  purchaseLines   PurchaseLine[]
  /// 关联这个工件的设计任务（R11）；有未完成（未取消）的设计任务时不发"可以开工"
  drawingTasks    DrawingTaskPart[]
  /// 需要这个工件的装配节点（R12 齐套）
  assemblyNodes   AssemblyNodePart[]

  @@unique([workOrderNumber, qmsBomId])
  @@index([workOrderNumber, drawingNo])
  @@index([qmsPartId])
  @@map("part")
}

enum StepMode {
  SELF // 自制
  IN_PLANT_OUTSOURCE // 厂内外协
  EXTERNAL_OUTSOURCE // 厂外外协
}

// 方案 4.3 状态机：待开工 → 在外加工/加工中 → 已完成 ⇄ 有异常
enum StepStatus {
  PENDING // 待开工
  OUT // 在外加工（厂外外协已发出）
  IN_PROGRESS // 加工中（自制/厂内外协）
  DONE // 已完成
  BLOCKED // 有异常（检验不合格）
}

model RouteStep {
  id                 String      @id @default(cuid())
  partId             String
  seq                Int
  processId          String      @db.VarChar(64) // QMS processes.id
  mode               StepMode
  supplierId         String?     @db.VarChar(64) // QMS suppliers.id：外协时为外协厂 / 厂内班组；自制时可选派工班组（kind = TEAM）
  ownerId            String?     @db.VarChar(64) // 负责人，QMS 用户 ID
  dueDate            DateTime?
  /// 应开工日（计划开工日，日期字段）：待办截止日优先取它
  planStartDate      DateTime?
  promisedReturnDate DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  status             StepStatus  @default(PENDING)
  /// 等变更（R9）：设计变更发放单 ID。发放时还没开工的工序打上，变更影响确认后清空；有值时 W2、W3 不计时
  holdReleaseId      String?     @db.VarChar(64)
  /// 最近一次解除"等变更"的时间：W2 从它和待办生成时间里较晚的那个重新计时
  holdClearedAt      DateTime?
  /// 所属总计划节点（R14，可空；老数据不挂）
  planNodeId         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  part               Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  planNode           PlanNode?   @relation(fields: [planNodeId], references: [id], onDelete: SetNull)
  events             FlowEvent[]

  @@unique([partId, seq])
  @@index([status])
  @@index([supplierId])
  @@index([holdReleaseId])
  @@index([planNodeId])
  @@map("route_step")
}

/// 工序路线模板（R8）：常用工序链。套用时把步骤复制到工件上，之后改模板不影响已套用的工件（复制即版本）
model RouteTemplate {
  id          String              @id @default(cuid())
  name        String              @unique @db.VarChar(191)
  description String?             @db.Text
  createdBy   String?             @db.VarChar(64)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  steps       RouteTemplateStep[]

  @@map("route_template")
}

model RouteTemplateStep {
  id          String        @id @default(cuid())
  templateId  String
  seq         Int
  processId   String        @db.VarChar(64) // QMS processes.id
  mode        StepMode
  supplierId  String?       @db.VarChar(64) // 外协时的默认外协厂，可空
  /// 默认工期（天）。套用时给了开工日才据此推算各道的要求完成日
  defaultDays Int?
  template    RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, seq])
  @@map("route_template_step")
}

enum FlowEventType {
  SEND // 发出
  RETURN // 返厂（QMS 报检）
  RETURN_MANUAL // 补登返厂（漏报兜底）
  START // 开工
  FINISH // 完工
  REPORT // 部分完工（报工）：计入已完成数量，步骤继续加工
  SCRAP // 报废：不计入已完成数量
}

enum FlowSource {
  MOBILE
  QMS_INSPECTION
  PC
}

/// 只允许新增，不允许修改（T9）。服务层不提供 update/delete。
model FlowEvent {
  id              String        @id @default(cuid())
  stepId          String
  type            FlowEventType
  qty             Int
  source          FlowSource
  qmsInspectionId String?       @unique @db.VarChar(64) // 同一报检重复同步时据此幂等跳过（T6）
  /// 备注：发出时的随件发料（外协带料）、报废原因等
  note            String?       @db.VarChar(500)
  actorId         String?       @db.VarChar(64)
  occurredAt      DateTime
  createdAt       DateTime      @default(now())
  step            RouteStep     @relation(fields: [stepId], references: [id])

  @@index([stepId])
  @@map("flow_event")
}

enum TodoStatus {
  OPEN
  DONE
  TRANSFERRED
  CANCELLED
}

model Todo {
  id        String     @id @default(cuid())
  ownerId   String     @db.VarChar(64)
  action    String     @db.VarChar(40) // 如 ARRANGE_SEND / ARRANGE_START / HANDLE_ISSUE / CONFIRM_MATCH
  refType   String     @db.VarChar(20)
  refId     String     @db.VarChar(64)
  dueAt     DateTime?
  status    TodoStatus @default(OPEN)
  doneAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([ownerId, status])
  @@index([refType, refId])
  @@map("todo")
}

enum UnmatchedStatus {
  PENDING
  RESOLVED
  IGNORED
}

model UnmatchedInspection {
  qmsInspectionId String          @id @db.VarChar(64)
  reason          String          @db.VarChar(40) // NO_CANDIDATE / MULTIPLE / CANCELLED_AFTER_MATCH
  candidates      Json?
  status          UnmatchedStatus @default(PENDING)
  resolvedBy      String?         @db.VarChar(64)
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([status])
  @@map("unmatched_inspection")
}

enum IssueCategory {
  DESIGN // 设计
  CHANGE // 变更
  MATERIAL_PAYMENT // 物料-付款原因
  MATERIAL_MGMT // 物料-管理原因
  OUTSOURCE_SCHEDULE // 外协-进度
  OUTSOURCE_QUALITY // 外协-质量
  WORKSHOP // 车间
  CUSTOMER // 客户
  OTHER // 其他
}

enum IssueSource {
  MANUAL
  ALERT
  QMS_NONCONFORMING
  SCRAP // 完工时报废，需补料重做
}

enum IssueStatus {
  OPEN // 待受理
  ACCEPTED // 处理中
  RESOLVED // 已处理，待确认
  CLOSED // 已关闭
}

model Issue {
  id                    String        @id @default(cuid())
  issueNo               String        @unique @db.VarChar(32)
  workOrderNumber       String        @db.VarChar(64)
  refType               String?       @db.VarChar(20)
  refId                 String?       @db.VarChar(64)
  category              IssueCategory
  description           String        @db.Text
  photos                Json?
  reporterId            String?       @db.VarChar(64)
  source                IssueSource
  responsibleDeptId     String?       @db.VarChar(64)
  responsibleUserId     String?       @db.VarChar(64)
  responsibleSupplierId String?       @db.VarChar(64)
  dueDate               DateTime?
  status                IssueStatus   @default(OPEN)
  escalationLevel       Int           @default(0)
  /// 系统来源的幂等键："QMS:<报检 ID>"、"ALERT:<预警 ID>"；手工上报为空（MySQL 唯一索引允许多个 NULL）
  sourceKey             String?       @unique @db.VarChar(120)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  logs                  IssueLog[]

  @@index([workOrderNumber, status])
  @@index([refType, refId])
  @@index([status])
  @@map("issue")
}

model IssueLog {
  id         String       @id @default(cuid())
  issueId    String
  fromStatus IssueStatus?
  toStatus   IssueStatus?
  note       String?      @db.Text
  actorId    String?      @db.VarChar(64)
  createdAt  DateTime     @default(now())
  issue      Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("issue_log")
}

enum AlertRule {
  W1
  W2
  W3
  W4
  W5 // 发放未签收（R9）
  W6 // 关键物料未到货（R10）
  W7 // 设计逾期 / 客户确认超期（R11）
  W8 // 装配节点未齐套（R12）
  W9 // 总计划节点延误 / 节点超时未确认（R14）
  W10 // 厂内工序逾期未完：自制 / 厂内外协开工后超过要求完成日
}

enum AlertLevel {
  REMIND
  YELLOW
  RED
}

enum AlertStatus {
  ACTIVE
  CLEARED
  CONVERTED // 已转异常
}

/// 同一对象同一规则只保留一条活动预警：MySQL 无部分唯一索引，
/// 用 activeKey（活动时 = "rule:refType:refId"，消除后置 null）上的唯一约束实现。
model Alert {
  id             String      @id @default(cuid())
  rule           AlertRule
  refType        String      @db.VarChar(20)
  refId          String      @db.VarChar(64)
  level          AlertLevel
  firstAt        DateTime
  levelAt        DateTime
  lastNotifiedAt DateTime?
  status         AlertStatus @default(ACTIVE)
  activeKey      String?     @unique @db.VarChar(120)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([refType, refId])
  @@map("alert")
}

model Reminder {
  id        String     @id @default(cuid())
  userId    String     @db.VarChar(64)
  alertId   String?
  todoId    String?
  title     String
  level     AlertLevel @default(REMIND)
  /// 提醒种类：空 = 预警/待办类；DIGEST = 每日汇总；SYNC_FAIL = QMS 同步连续失败（发给管理员，未读时置顶）；
  /// RELEASE = 发放单的通知（接收人拒收时发给发放人），跳转地址在 link；PLAN = 总计划节点被部门退回（发给项目经理，R14），跳转地址在 link
  kind      String?    @db.VarChar(20)
  /// 电脑端跳转地址（RELEASE / PLAN / COMMENT 用；预警类按 alertId 现算）。用 TEXT：工单号会被 URL 编码，中文工单号很快超过 191
  link      String?    @db.Text
  /// 每日汇总的正文（前 5 项，一行一项）
  body      String?    @db.Text
  /// 防重复：每日汇总 "DIGEST:<YYYY-MM-DD>:<userId>"，同人同日只有一条；同步失败 "SYNC_FAIL:<故障开始时间>:<userId>"，同一轮故障只有一条；
  /// 拒收通知 RELEASE_REJECT:<签收记录 ID>，同一次拒收只有一条；总计划退回 PLAN_REJECT:<节点 ID>:<时间>:<userId>
  dedupeKey String?    @unique @db.VarChar(120)
  readAt    DateTime?
  createdAt DateTime   @default(now())

  // 同一个人在同一条预警的同一个级别上只收一条（alertId 为空的待办类提醒不受限，MySQL 唯一索引允许多个 NULL）
  @@unique([alertId, level, userId])
  @@index([userId, readAt])
  @@map("reminder")
}

/// 阈值表。各列含义按规则不同：W1 提醒为小时；W3 的 remindHours 是"承诺返回日前多少小时"（48 = 前 2 天），
/// W3 的黄/红是超期天数。表里没有的规则用 services/alerts/rules.ts 的默认值。
model Threshold {
  rule        AlertRule @id
  remindHours Int?
  yellowDays  Int
  redDays     Int

  @@map("threshold")
}

model OffDay {
  date DateTime @id @db.Date

  @@map("off_day")
}

enum NotifyRoleKind {
  OUTSOURCE_COORDINATOR // 外协专员（W1 的责任人）
  DEPT_HEAD // 部门负责人，department 填业务部门名称（技术部/工艺部/采购部/生产部/质量部/财务部/项目部；用户部门经 dept_mapping 换成业务部门后对应）
  PROJECT_DEPT_HEAD // 项目部负责人
  LEADER // 分管领导
  FINANCE // 财务（R10）：付款申请标记已付 / 暂缓
}

/// 预警升级阶梯的通知对象（方案 6.2）。QMS 里没有这些角色，先在设置页手工维护。
model NotifyRole {
  id         String         @id @default(cuid())
  role       NotifyRoleKind
  userId     String         @db.VarChar(64)
  department String?        @db.VarChar(191)

  @@index([role])
  @@map("notify_role")
}

/// 业务部门（权限方案 R13）：用户的 QMS 部门对到这 7 个大部门之一；没对上的算"其他"
enum BusinessDept {
  TECH // 技术部
  PROCESS // 工艺部：按图纸分解料单发下料车间、编制下发工艺文件、定工艺路线
  PURCHASE // 采购部
  PRODUCTION // 生产部
  QUALITY // 质量部
  FINANCE // 财务部
  PROJECT // 项目部
}

/// 班组 → 班组长（生产管理重设计第二批）。一个班组一个班组长，一个人可以带多个班组。
/// 班组来自 QMS 同步（qms_supplier kind = TEAM），班组长是本系统设置页维护的，单独成表，同步不会覆盖或清掉。
/// 自制工序派到班组、没有指定负责人时，待办和提醒发给班组长（flow/responsible.ts）；班组长可以登记本班组自制工序的开工、完工、报工。
model TeamLeader {
  supplierId String      @id @db.VarChar(64)
  userId     String      @db.VarChar(64)
  updatedAt  DateTime    @updatedAt
  updatedBy  String      @db.VarChar(64)
  team       QmsSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user       QmsUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("team_leader")
}

/// QMS 部门 → 业务部门对照（设置页"部门对照"维护，班组、科室都对到大部门）。
/// 没有对照的部门沿 parentId 找最近有对照的上级；都没有时按 QMS 部门名称本身（名称正好叫"生产部"等的照常生效）
model DeptMapping {
  qmsDepartmentId String       @id @db.VarChar(64)
  businessDept    BusinessDept
  updatedAt       DateTime     @updatedAt

  @@map("dept_mapping")
}

/// 后台任务防重叠的租约锁：lockedUntil 未过期即被占用；进程崩溃后租约到期自动失效，不依赖数据库连接。
model JobLock {
  name        String   @id @db.VarChar(40)
  lockedUntil DateTime @db.DateTime(3)
  holder      String?  @db.VarChar(64)

  @@map("job_lock")
}

/// 上传的文件（异常照片、发放单附件）。文件存在 runtimeConfig.uploadDir 下，文件名是随机 id，不用用户给的文件名。
/// issueId：上报异常时绑定；releaseId：建发放单时绑定（R9）。未绑定的只有上传人自己能读取，
/// 绑定后按异常/发放单所属工单的可见范围判断（发放单的接收人也能读）。
model UploadFile {
  id         String   @id @db.VarChar(64)
  storedName String   @db.VarChar(80)
  mime       String   @db.VarChar(100)
  size       Int
  uploaderId String   @db.VarChar(64)
  issueId    String?  @db.VarChar(64)
  releaseId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([issueId])
  @@index([releaseId])
  @@map("upload_file")
}

// ───────────── 发放签收（R9）─────────────

enum ReleaseType {
  DRAWING // 图纸
  CHANGE // 设计变更
  PROCESS // 工艺文件
}

enum ReleaseStatus {
  ACTIVE // 有效
  VOID // 已作废（发错了；未签收的签收记录一并作废）
}

enum ReceiptStatus {
  PENDING // 待签收
  SIGNED // 已签收
  REJECTED // 已拒收（写原因）
  CANCELLED // 发放单作废
}

/// 发放单：图纸、设计变更、工艺文件。纸质图纸照旧下发，这里登记"发给谁、谁签收"；附件可选。不做审批。
/// 表名用 doc_release（RELEASE 是 MySQL 保留字）。
model Release {
  id                String           @id @default(cuid())
  /// FF-YYMMDD-001（工厂时区当天序号）
  releaseNo         String           @unique @db.VarChar(32)
  type              ReleaseType
  workOrderNumber   String           @db.VarChar(64)
  /// 关联工件 ID（字符串数组，可空）。设计变更按它找受影响的工序
  partIds           Json?
  version           String?          @db.VarChar(64)
  description       String           @db.Text
  issuerId          String           @db.VarChar(64)
  status            ReleaseStatus    @default(ACTIVE)
  /// 设计变更：变更影响已确认（或没有在加工的工序、全部签收后自动解除）的时间；此后关联工序的"等变更"已解除
  changeConfirmedAt DateTime?
  /// 确认人；自动解除时为空
  changeConfirmedBy String?          @db.VarChar(64)
  changeConfirmNote String?          @db.VarChar(500)
  /// 从设计任务一键发放时关联的设计任务（R11）。不是作废状态的发放单 = 该任务的图纸已发放
  drawingTaskId     String?          @db.VarChar(64)
  /// 图纸发放单附的技术部 BOM 表（upload_file.id，同时绑定到本发放单）。发放时已按它建好工件并关联（partIds）
  bomFileId         String?          @db.VarChar(64)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  receipts          ReleaseReceipt[]

  @@index([workOrderNumber, createdAt])
  @@index([issuerId])
  @@index([drawingTaskId])
  @@map("doc_release")
}

/// 签收记录：每个接收人一条（流转记录），同时给他生成一条"签收"待办（todo.refType = receipt）
model ReleaseReceipt {
  id        String        @id @default(cuid())
  releaseId String
  userId    String        @db.VarChar(64)
  status    ReceiptStatus @default(PENDING)
  /// 拒收原因
  reason    String?       @db.VarChar(500)
  /// 签收 / 拒收 / 作废的时间
  actedAt   DateTime?
  createdAt DateTime      @default(now())
  release   Release       @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@index([userId, status])
  @@index([status])
  @@map("release_receipt")
}

// ───────────── 关键物料与付款（R10）─────────────

enum PurchaseStatus {
  OPEN // 未到货
  ARRIVED // 已到货
  CANCELLED // 已取消（不再跟踪）
}

/// 到货延误原因：付款 = 付款原因；其余三类统计时合并为"管理原因"（与异常分类 物料-付款原因 / 物料-管理原因 对应）
enum DelayReason {
  PAYMENT // 付款
  SUPPLIER // 供应商
  DEMAND_CHANGE // 我方需求变化
  OTHER // 其他
}

/// 采购跟踪行：只跟踪关键物料（长周期、进口、大件），采购员手工录入或 Excel 导入。不导入全 BOM。
/// 责任人：buyerId（指定到人）；为空时是采购部负责人（notify_role 里 DEPT_HEAD + 部门"采购部"）。
model PurchaseLine {
  id              String                 @id @default(cuid())
  workOrderNumber String                 @db.VarChar(64)
  /// 用这批物料的工件（R8 工件，可空）。工件的关键物料全部到货时给第一道工序负责人发"可以开工"待办
  partId          String?
  materialName    String                 @db.VarChar(191)
  spec            String?                @db.VarChar(191)
  quantity        Decimal                @db.Decimal(14, 3)
  unit            String?                @db.VarChar(20)
  /// 选了 QMS 供应商时填 ID（进货检验自动到货时要求一致）；supplierName 总是存名称（选的或手填的）
  supplierId      String?                @db.VarChar(64)
  supplierName    String?                @db.VarChar(191)
  /// 需求日、承诺到货日、实际到货日：日期字段，存当天 UTC 零点
  needDate        DateTime
  promisedDate    DateTime?
  arrivedDate     DateTime?
  status          PurchaseStatus         @default(OPEN)
  buyerId         String?                @db.VarChar(64)
  /// 到货延误（实际/当前晚于承诺到货日或需求日）时填的原因类别
  delayReason     DelayReason?
  delayNote       String?                @db.VarChar(500)
  note            String?                @db.VarChar(500)
  /// 到货确认：来源（手机 / 电脑 / QMS 进货检验）、确认人、确认时间
  arrivalSource   FlowSource?
  arrivedBy       String?                @db.VarChar(64)
  arrivedAt       DateTime?
  /// QMS 进货检验自动确认到货时的报检 ID。撤销到货后保留：这一行之后只能手工确认
  qmsInspectionId String?                @unique @db.VarChar(64)
  /// 所属总计划节点（R14，可空；老数据不挂）
  planNodeId      String?
  createdBy       String?                @db.VarChar(64)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  part            Part?                  @relation(fields: [partId], references: [id], onDelete: SetNull)
  planNode        PlanNode?              @relation(fields: [planNodeId], references: [id], onDelete: SetNull)
  payments        PaymentLine[]
  /// 需要这项物料的装配节点（R12 齐套）
  assemblyNodes   AssemblyNodePurchase[]

  @@index([workOrderNumber, status])
  @@index([status, needDate])
  @@index([partId])
  @@index([planNodeId])
  @@map("purchase_line")
}

/// 每条 QMS 进货检验（INCOMING）只自动处理一次：MATCHED = 已确认到货；NO_CANDIDATE / MULTIPLE = 没对上 / 对上多条，留给手工确认
model IncomingCheck {
  qmsInspectionId String   @id @db.VarChar(64)
  result          String   @db.VarChar(20)
  purchaseLineId  String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@map("incoming_check")
}

enum PaymentStatus {
  PENDING // 待付
  PAID // 已付
  ON_HOLD // 暂缓
}

/// 付款申请：不做审批。财务（notify_role FINANCE）或管理员改状态（待付 / 已付 / 暂缓）。
/// 关联的采购行必须是同一工单（可见范围按工单判断）。
model PaymentRequest {
  id              String        @id @default(cuid())
  workOrderNumber String        @db.VarChar(64)
  amount          Decimal       @db.Decimal(14, 2)
  requestDate     DateTime
  /// 卡交期：如供应商不收预付款不发货
  blocksDelivery  Boolean       @default(false)
  status          PaymentStatus @default(PENDING)
  /// 申请说明
  note            String?       @db.VarChar(500)
  /// 财务处理意见（改状态时填，可空）
  financeNote     String?       @db.VarChar(500)
  requesterId     String        @db.VarChar(64)
  statusBy        String?       @db.VarChar(64)
  statusAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           PaymentLine[]

  @@index([status])
  @@index([workOrderNumber])
  @@map("payment_request")
}

model PaymentLine {
  paymentId      String
  purchaseLineId String
  payment        PaymentRequest @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseLine   PurchaseLine   @relation(fields: [purchaseLineId], references: [id])

  @@id([paymentId, purchaseLineId])
  @@index([purchaseLineId])
  @@map("payment_request_line")
}

// ───────────── 设计任务（R11）─────────────

/**
 * 设计任务状态（由事实推出，见 services/drawings/constants.ts deriveStatus）：
 * 设计中 → 设计完成（图纸还没发放）→ 待客户确认（已发放、需要客户确认但还没确认）→ 已完成；另有 已取消。
 */
enum DrawingTaskStatus {
  PENDING // 设计中
  DRAWN // 设计完成（图纸还没发放）
  CUSTOMER_PENDING // 待客户确认
  DONE // 已完成（设计完成、已发放、需要时客户已确认）
  CANCELLED // 已取消
}

/**
 * 设计任务：按部件拆。关联工件可多选，也可以不关联工件只写部件名称。
 * 责任人：设计负责人（ownerId）；没指定时是技术部负责人（notify_role DEPT_HEAD + 部门"技术部"）。
 * 关联工件存在未完成（未取消）的设计任务时，不发"可以开工"待办（purchases.ts refreshPartReady）。
 */
model DrawingTask {
  id                    String            @id @default(cuid())
  workOrderNumber       String            @db.VarChar(64)
  /// 部件名称（如"主梁总图"、"液压系统"）
  componentName         String            @db.VarChar(191)
  ownerId               String?           @db.VarChar(64)
  /// 计划完成日（设计）、实际设计完成日；日期字段，存当天 UTC 零点
  planDate              DateTime
  drawnDate             DateTime?
  drawnBy               String?           @db.VarChar(64)
  /// 客户确认：是否需要、计划日、实际确认日
  needsCustomerConfirm  Boolean           @default(false)
  customerPlanDate      DateTime?
  customerConfirmedDate DateTime?
  customerConfirmedBy   String?           @db.VarChar(64)
  status                DrawingTaskStatus @default(PENDING)
  note                  String?           @db.VarChar(500)
  /// 所属总计划节点（R14，可空；老数据不挂）
  planNodeId            String?
  createdBy             String?           @db.VarChar(64)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  planNode              PlanNode?         @relation(fields: [planNodeId], references: [id], onDelete: SetNull)
  parts                 DrawingTaskPart[]

  @@index([workOrderNumber, status])
  @@index([ownerId, status])
  @@index([status, planDate])
  @@index([planNodeId])
  @@map("drawing_task")
}

model DrawingTaskPart {
  taskId String
  partId String
  task   DrawingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  part   Part        @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([taskId, partId])
  @@index([partId])
  @@map("drawing_task_part")
}

// ───────────── 齐套（R12）─────────────

/**
 * 装配节点：工单下的总装 / 部装节点，带需求日。节点清单 = 需要的工件（part）+ 关键物料（purchase_line，同一工单）；
 * 同一工件 / 物料可以挂在多个节点上，不互斥。齐套率现算不落库（services/kitting）：
 * 已就绪项 ÷ 应有项（已取消的物料不计入）；工件就绪 = part.status DONE（最后一道工序完成时 flow.ts 置 DONE），物料就绪 = 已到货。
 * 负责人 ownerId 为空 = 生产经理（notify_role DEPT_HEAD + 部门"生产部"）。W8 未齐套预警见 alerts/scan.ts。
 */
model AssemblyNode {
  id              String                 @id @default(cuid())
  workOrderNumber String                 @db.VarChar(64)
  name            String                 @db.VarChar(191)
  /// 需求日：日期字段，存当天 UTC 零点
  needDate        DateTime
  ownerId         String?                @db.VarChar(64)
  note            String?                @db.VarChar(500)
  /// 工单内的显示顺序（小的在前）
  sortOrder       Int                    @default(0)
  /// 所属总计划节点（R14，可空；老数据不挂）
  planNodeId      String?
  createdBy       String?                @db.VarChar(64)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  planNode        PlanNode?              @relation(fields: [planNodeId], references: [id], onDelete: SetNull)
  parts           AssemblyNodePart[]
  purchases       AssemblyNodePurchase[]

  @@index([workOrderNumber, sortOrder])
  @@index([needDate])
  @@index([ownerId])
  @@index([planNodeId])
  @@map("assembly_node")
}

model AssemblyNodePart {
  nodeId String
  partId String
  node   AssemblyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  part   Part         @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([nodeId, partId])
  @@index([partId])
  @@map("assembly_node_part")
}

model AssemblyNodePurchase {
  nodeId         String
  purchaseLineId String
  node           AssemblyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  purchase       PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)

  @@id([nodeId, purchaseLineId])
  @@index([purchaseLineId])
  @@map("assembly_node_purchase")
}

// ───────────── 项目部总计划（R14）─────────────

/**
 * 总计划模板：节点名称、顺序、责任部门、"交期前多少天"。按模板生成时按 QMS 交期倒推各节点计划日。
 * 设置页"总计划模板"维护（项目部负责人、管理员）；迁移里内置一个"通用"模板。
 */
model PlanTemplate {
  id          String             @id @default(cuid())
  name        String             @unique @db.VarChar(191)
  description String?            @db.VarChar(500)
  createdBy   String?            @db.VarChar(64)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  nodes       PlanTemplateNode[]

  @@map("plan_template")
}

model PlanTemplateNode {
  id                 String       @id @default(cuid())
  templateId         String
  seq                Int
  name               String       @db.VarChar(191)
  dept               BusinessDept
  /// 交期前多少天（0 = 交期当天，如"发运"）
  daysBeforeDelivery Int
  /// 阶段（如"图纸设计及文件下发""采购"；页面按阶段分组显示）
  phase              String?      @db.VarChar(64)
  /// 工期（天，含首尾）：生成时计划开始日 = 计划完成日 - 工期 + 1；空 = 不设开始日
  durationDays       Int?
  /// 前置节点（本模板里的顺序号数组，如 [3, 8]）：null = 默认上一个节点；[] = 没有前置
  predSeqs           Json?
  /// 上级节点的顺序号（子节点，只有一层；上级要排在前面）：null = 一级节点
  parentSeq          Int?
  template           PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, seq])
  @@map("plan_template_node")
}

enum PlanStatus {
  DRAFT // 草稿：项目经理还在排，不预警、不要求部门记录挂节点
  PUBLISHED // 已发布：基线锁定，改日期要写原因
}

/**
 * 每个工单一份总计划的发布状态（节点在 plan_node）
 */
model WorkOrderPlan {
  workOrderNumber String     @id @db.VarChar(64)
  status          PlanStatus @default(DRAFT)
  /// 按哪个模板生成的（名称快照，模板改名、删除不影响）
  templateName    String?    @db.VarChar(191)
  publishedAt     DateTime?
  publishedBy     String?    @db.VarChar(64)
  createdBy       String?    @db.VarChar(64)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("work_order_plan")
}

enum PlanNodeConfirm {
  PENDING // 待确认（发布后、改期后）
  CONFIRMED // 已确认
  REJECTED // 已退回（写原因，提醒项目经理）
}

/**
 * 总计划节点：按 seq 排成一条主线，最后一个节点（一般是"发运"）对应工单交期。
 * 计划日、基线日（发布时锁定）、实际完成日：日期字段，存当天 UTC 零点。
 * 完成：挂靠的部门任务全部完成时自动完成（现算，不落库）；也可以手动标记（manualDoneAt 有值，actualDate = 手动填的日期）。
 * 部门确认：发布后给责任部门负责人发"确认总计划节点"待办（todo.refType = planNode）；未发布时 confirmStatus 为空。
 */
model PlanNode {
  id              String           @id @default(cuid())
  workOrderNumber String           @db.VarChar(64)
  seq             Int
  name            String           @db.VarChar(191)
  dept            BusinessDept
  /// 阶段（如"图纸设计及文件下发""采购"；页面按阶段分组显示，空 = 不分组）
  phase           String?          @db.VarChar(64)
  /// 计划开始日（可选，日期字段）：甘特图画横道；有开始日时前置节点只在晚到"开始日前一天"之后才往后推（中间的空档是余量）
  startDate       DateTime?
  planDate        DateTime
  baselineDate    DateTime?
  /// 前置节点是否自定：false = 默认（一级节点等上一个一级节点，子节点等上级节点的前置）；true = 用 plan_node_dep 里的（可以为空 = 没有前置）
  customDeps      Boolean          @default(false)
  /// 上级节点（10-22，子节点只有一层）：上级是汇总行（10-23），计划开始日 / 完成日由子节点汇总、不用部门确认；子节点都完成上级才算完成，
  /// 子节点晚了上级跟着晚；子节点的阶段跟上级。上级删了子节点变回一级节点（服务层先拦）
  parentId        String?
  parent          PlanNode?        @relation("PlanNodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        PlanNode[]       @relation("PlanNodeTree")
  /// 手动标记完成时的完成日（自动完成不写这里，现算）
  actualDate      DateTime?
  manualDoneBy    String?          @db.VarChar(64)
  manualDoneAt    DateTime?
  confirmStatus   PlanNodeConfirm?
  confirmedBy     String?          @db.VarChar(64)
  confirmedAt     DateTime?
  rejectReason    String?          @db.VarChar(500)
  note            String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  drawingTasks    DrawingTask[]
  purchaseLines   PurchaseLine[]
  routeSteps      RouteStep[]
  assemblyNodes   AssemblyNode[]
  planTasks       PlanTask[]
  preds           PlanNodeDep[]    @relation("PlanNodeDepSucc")
  succs           PlanNodeDep[]    @relation("PlanNodeDepPred")

  @@index([workOrderNumber, seq])
  @@index([confirmStatus])
  @@index([parentId])
  @@map("plan_node")
}

/**
 * 总计划节点的前置关系（10-22，按真实 MS Project 计划：多条线并行，各节点只等自己的前置节点）。
 * 完成-开始：前置节点晚了，后续节点跟着往后推（有计划开始日时扣掉中间的空档）。同一工单内、不能成环（服务层校验）。
 * 只有 plan_node.customDeps = true 的节点才看这里；任一端节点删了，关系一起删。
 */
model PlanNodeDep {
  nodeId String
  predId String
  node   PlanNode @relation("PlanNodeDepSucc", fields: [nodeId], references: [id], onDelete: Cascade)
  pred   PlanNode @relation("PlanNodeDepPred", fields: [predId], references: [id], onDelete: Cascade)

  @@id([nodeId, predId])
  @@index([predId])
  @@map("plan_node_dep")
}

/**
 * 部门计划二次分解（10-22）："其他任务"——总计划节点下、设计任务 / 采购行 / 工序 / 装配节点覆盖不到的部门工作
 * （如合同评审、BOM 编制、工艺文件、调试、出厂检验、发运准备）。只分一级，必须挂节点；节点删了任务一起删。
 * 完成 = doneDate 有值。建好后给负责人发"完成部门任务"待办（todo.refType = planTask，dueAt = 计划完成日），完成时关掉。
 * 计划完成日、完成日：日期字段，存当天 UTC 零点。
 */
model PlanTask {
  id              String    @id @default(cuid())
  workOrderNumber String    @db.VarChar(64)
  planNodeId      String
  name            String    @db.VarChar(191)
  ownerId         String    @db.VarChar(64)
  planDate        DateTime
  doneDate        DateTime?
  doneBy          String?   @db.VarChar(64)
  note            String?   @db.VarChar(500)
  createdBy       String?   @db.VarChar(64)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  planNode        PlanNode  @relation(fields: [planNodeId], references: [id], onDelete: Cascade)

  @@index([planNodeId])
  @@index([workOrderNumber])
  @@index([ownerId])
  @@map("plan_task")
}

/**
 * 总计划调整记录（发布后才记）：改日期（写原因）、加节点、删节点。节点删了记录还在（存名称快照，不设外键）
 */
model PlanChangeLog {
  id              String    @id @default(cuid())
  workOrderNumber String    @db.VarChar(64)
  nodeId          String    @db.VarChar(191)
  nodeName        String    @db.VarChar(191)
  /// DATE = 改计划日；ADD = 发布后加节点；DELETE = 发布后删节点
  kind            String    @db.VarChar(20)
  oldDate         DateTime?
  newDate         DateTime?
  reason          String    @db.VarChar(500)
  actorId         String    @db.VarChar(64)
  createdAt       DateTime  @default(now())

  @@index([workOrderNumber, createdAt])
  @@index([nodeId])
  @@map("plan_change_log")
}

// ───────────── 登录会话 ─────────────

/// 履约自己的会话（30 天）。id 存的是 cookie 令牌的 SHA-256，库里不存明文令牌。
model Session {
  id         String   @id @db.Char(64)
  qmsUserId  String   @db.VarChar(64)
  userName   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([qmsUserId])
  @@index([expiresAt])
  @@map("session")
}

/// 登录进行中的临时记录（10 分钟）：state 一次性消费，code_verifier 只存在服务端。
model LoginAttempt {
  id           String   @id @db.Char(64) // state 的 SHA-256
  codeVerifier String   @db.VarChar(128)
  redirect     String   @db.VarChar(512)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("login_attempt")
}

/// 留言（借鉴 ERPNext 的记录评论，10-26）：挂在工件 / 采购行上，可以 @人，被 @ 的人收到提醒（kind = COMMENT）。只新增不修改
model Comment {
  id              String   @id @default(cuid())
  /// part = 工件，purchase = 采购行
  refType         String   @db.VarChar(20)
  refId           String   @db.VarChar(64)
  workOrderNumber String   @db.VarChar(64)
  authorId        String   @db.VarChar(64)
  body            String   @db.Text
  /// 被 @ 的人（QMS 用户 ID 数组）
  mentionIds      Json?
  createdAt       DateTime @default(now())

  @@index([refType, refId])
  @@index([workOrderNumber])
  @@map("comment")
}
