# Copy to deploy/production.env (0600). Never commit the filled file.
# Single-quoted values preserve literal $ characters in Docker Compose.
FT_DEPLOYMENT_MODE=production
DATABASE_URL='mysql://fulfillment:CHANGE_ME@mysql.internal:3306/fulfillment'
NUXT_DEV_TOOLS=0
NUXT_ISOLATED_DEMO=0
NUXT_SANDBOX=0
NUXT_QMS_SYNC_ENABLED=1
NUXT_QMS_API_BASE=http://qms-backend:3000
NUXT_QMS_AUTHORIZE_URL=https://CHANGE_ME/#/identity/authorize
NUXT_QMS_CALLBACK_URL=https://CHANGE_ME/auth/callback
NUXT_QMS_CLIENT_ID=fulfillment
NUXT_QMS_CLIENT_SECRET='CHANGE_ME'
NUXT_ADMIN_USER_IDS=CHANGE_ME
NUXT_UPLOAD_DIR=/app/data/uploads
GRAFANA_ADMIN_PASSWORD='CHANGE_ME'
ALERT_EMAIL_FROM=CHANGE_ME
ALERT_EMAIL_TO=CHANGE_ME
ALERT_SMTP_ADDRESS=CHANGE_ME
ALERT_SMTP_USERNAME=CHANGE_ME
ALERT_SMTP_PASSWORD='CHANGE_ME'
ALERT_PUBLIC_HEALTH_URL=https://CHANGE_ME/api/health
