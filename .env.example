# 复制为 .env 后填写。.env 不提交。

# 履约库（本地：docker compose up -d mysql）
DATABASE_URL="mysql://fulfillment:CHANGE_ME@127.0.0.1:3306/fulfillment"

# QMS 身份桥（与 QMS 的 QMS_IDENTITY_CLIENT_ID / 密钥 / QMS_IDENTITY_CALLBACK 一致）
NUXT_QMS_API_BASE="http://localhost:3000"
NUXT_QMS_AUTHORIZE_URL="http://localhost:5666/#/auth/identity-authorize"
NUXT_QMS_TOKEN_PATH="/api/identity-bridge/token"
NUXT_QMS_VERIFY_PATH="/api/identity-bridge/verify"
NUXT_QMS_CLIENT_ID="fulfillment"
NUXT_QMS_CLIENT_SECRET=""
NUXT_QMS_CALLBACK_URL="https://localhost:3100/auth/callback"

# 本地 https（pnpm cert:local 生成后填写）
DEV_HTTPS_KEY="certs/localhost-key.pem"
DEV_HTTPS_CERT="certs/localhost.pem"
